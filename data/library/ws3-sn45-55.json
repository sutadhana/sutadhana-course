ikārasampadā","label":"feminine noun · nominative singular","ctx":"accomplishment in wise attention","q":"yonisomanasikārasampadā","dpd":"accomplishment of radical attention; success in paying proper attention","construction":"yoniso + manasikāra + sampadā","heads":[{"lemma":"yonisomanasikārasampadā","meaning":"accomplishment of radical attention; success in paying proper attention"}],"parse":true,"pos":"fem","para":"saddha"},"yoniso-manasi-kāra-sampannass’etaṃ":{"form":"yoniso-manasi-kāra-sampannass’etaṃ","lemma":"yonisomanasikārasampannassa + etaṃ","label":"two words joined (sandhi)","ctx":"for one accomplished in wise attention, this","q":"yonisomanasikārasampanna","note":"The final a of sampannassa drops before the e of etaṃ.","parts":[{"form":"yoniso-manasi-kāra-sampannassa","label":"adjective · masculine genitive singular of yonisomanasikārasampanna","meaning":"accomplished in wise attention"},{"form":"etaṃ","label":"pronoun · neuter nominative singular of eta","meaning":"this"}],"heads":[],"parse":false},"pāṭikaṅkhaṃ":{"form":"pāṭikaṅkhaṃ","lemma":"pāṭikaṅkha","label":"potential participle · neuter nominative singular","ctx":"to be expected","q":"pāṭikaṅkha","dpd":"to be expected; certain (for); can be anticipated","lit":"to be wished","heads":[{"lemma":"pāṭikaṅkha","meaning":"to be expected; certain (for); can be anticipated"}],"parse":true,"pos":"ptp","para":"gantabba"},"ariyaṃ":{"form":"ariyaṃ","lemma":"ariya","label":"adjective · masculine accusative singular","ctx":"noble","q":"ariya","dpd":"noble; distinguished; of an awakened being; of the Buddha","heads":[{"lemma":"ariya","meaning":"noble; distinguished; of an awakened being; of the Buddha"}],"parse":true,"pos":"adj","para":"anicca"},"aṭṭh’aṅgikaṃ":{"form":"aṭṭh’aṅgikaṃ","lemma":"aṭṭhaṅgika","label":"adjective · masculine accusative singular","ctx":"eightfold","q":"aṭṭhaṅgika","dpd":"with eight parts; eight-limbed; eightfold","construction":"aṭṭha + aṅgika","heads":[{"lemma":"aṭṭhaṅgika","meaning":"wi