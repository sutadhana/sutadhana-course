"],[" "],["adinnaṃ","adinnaṃ"],[" "],["ādiyati","ādiyati"],[", "],["na","na"],[" "],["para-dāraṃ","para-dāraṃ"],[" "],["gacchati","gacchati"],[", "],["na","na"],[" "],["musā","musā"],[" "],["bhaṇati","bhaṇati"],[", "],["paraṃ","paraṃ"],[" "],["pi","pi"],[" "],["na","na"],[" "],["tathattāya","tathattāya"],[" "],["samādapeti","samādapeti"],[", "],["yaṃ’sa","yaṃ’sa"],[" "],["hoti","hoti"],[" "],["dīgha-rattaṃ","dīgha-rattaṃ"],[" "],["hitāya","hitāya"],[" "],["sukhāyā’","sukhāyā’"],["”"],["ti","ti"],[".\n“"],["Evaṃ","evaṃ"],[", "],["bhante","bhante"],[".”"]],"en":"“What do you think, Sāḷha, is there non-delusion?”\n“Yes, bhante.”\n“I say the meaning of this is true knowledge. An undeluded one, who has arrived at true knowledge, does not destroy life, take what is not given, go to another’s wife, or speak falsely; nor does he encourage others to do likewise, which will lead to his welfare and happiness for a long time.”\n“Yes, bhante.”"},{"t":[["“"],["Taṃ","taṃ"],[" "],["kiṃ","kiṃ"],[" "],["maññatha","maññatha"],[", "],["Sāḷhā","sāḷhā"],[", "],["ime","ime"],[" "],["dhammā","dhammā"],[" "],["kusalā","kusalā"],[" "],["vā","vā"],[" "],["akusalā","akusalā"],[" "],["vā’","vā’"],["”"],["ti","ti"],["?\n“"],["Kusalā","kusalā"],[", "],["bhante","bhante"],[".”\n“"],["Sāvajjā","sāvajjā"],[" "],["vā","vā"],[" "],["anavajjā","anavajjā"],[" "],["vā’","vā’"],["”"],["ti","ti"],["?\n“"],["Anavajjā","anavajjā"],[", "],["bhante","bhante"],[".”\n“"],["Viññu-garahitā","viññu-garahitā"],[" "],["vā","vā"],[" "],["viññu-ppasatthā","viññu-ppasatthā"],[" "],["vā’","vā’"],["”"],["ti","ti"],["?\n“"],["Viññu-ppasatthā","viññu-ppasatthā"],[", "],["bhante","bhante"],[".”\n“"],["Samattā","samattā"],[" "],["samādinnā","samādinnā"],[" "],["hitāya","hitāya"],[" "],["sukhāya","sukhāya"],[" "],["saṃvattanti","saṃvattanti"],[", "],["no","no"],[" "],["vā","vā"],["?”\n“"],["Samattā","samattā"],[", "],["bhante","bhante"],[", "],["samādinnā","samādinnā"],[" "],["hitāya","hitāya"],[" "],["sukhāya","sukhāya"],[" "],["saṃvattantī’","saṃvattantī’"],["”"],["ti","ti"],["."]],"en":"“What do you think, Sāḷha? Are these things wholesome or unwholesome?”\n“Wholesome, bhante.”\n“Blameworthy or blameless?”\n“Blameless, bhante.”\n“Censured by the wise or praised by the wise?”\n“Praised by the wise, bhante.”\n“Accepted and undertaken, do they lead to welfare and happiness or not?”\n“Accepted and undertaken, bhante, these things lead to welfare and happiness.”"},{"t":[["“"],["Yadā","yadā"],[" "],["tumhe","tumhe"],[", "],["Sāḷhā","sāḷhā"],[", "],["attanā’va","attanā’va"],[" "],["jāneyyātha","jāneyyātha"],[": ‘"],["ime","ime"],[" "],["dhammā","dhammā"],[" "],["kusalā","kusalā"],[", "],["ime","ime"],[" "],["dhammā","dhammā"],[" "],["anavajjā","anavajjā"],[", "],["ime","ime"],[" "],["dhammā","dhammā"],[" "],["viññu-ppasatthā","viññu-ppasatthā"],[", "],["ime","ime"],[" "],["dhammā","dhammā"],[" "],["samattā","samattā"],[" "],["samādinnā","samādinnā"],[" "],["dīgha-rattaṃ","dīgha-rattaṃ"],[" "],["hitāya","hitāya"],[" "],["sukhāya","sukhāya"],[" "],["saṃvattantī’ti","saṃvattantī’ti"],[", "],["atha","atha"],[" "],["tumhe","tumhe"],[", "],["Sāḷhā","sāḷhā"],[", "],["upasampajja","upasampajja"],[" "],["vihareyyāthā’","vihareyyāthā’"],["”"],["ti","ti"],["."]],"en":"“When, Sāḷha, you know for yourselves: ‘These things are wholesome; these things are blameless; these things are praised by the wise; these things, if accepted and undertaken, lead to welfare and happiness for a long time,’ then you should live in accordance with them.”"}],"words":{"taṃ":{"form":"taṃ","lemma":"ta","dpdId":"29188","pos":"pron","dpd":"that","more":["(letter) (gram) letter t; 24th letter of the alphabet; dental sibilant","(suffix) (gram) primary suffix used to form past participles and nouns"],"label":"pronoun · neuter accusative singular","q":"ta","ctx":"that","note":"Taṃ kiṃ maññatha: “What do you think of that?”","heads":[{"lemma":"ta","meaning":"that"}],"parse":true},"kiṃ":{"form":"kiṃ","lemma":"ka","dpdId":"19158","pos"