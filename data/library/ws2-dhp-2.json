{"id":"ws2-dhp-2","title":"Dhammapada Verses","titleEn":"","ref":"","source":"Pāḷi Workshop booklet","credit":"Pāḷi text and English translation as in Mor’s Pāḷi Workshop booklet.","section":"extra","collection":"workshop","group":"2 · sammāvācā","groupSub":"Right Speech","paras":[{"t":[["vacī-pakopaṃ","vacī-pakopaṃ"],[" "],["rakkheyya","rakkheyya"],[","],["\n"],["vācāya","vācāya"],[" "],["saṃvuto","saṃvuto"],[" "],["siyā","siyā"],["."],["\n"],["vacī-duccaritaṃ","vacī-duccaritaṃ"],[" "],["hitvā","hitvā"],[","],["\n"],["vācāya","vācāya"],[" "],["sucaritaṃ","sucaritaṃ"],[" "],["care","care"],["."]],"en":"One should guard against angry speech,\nlet one be restrained in speech.\nAbandoning verbal misconduct,\none should practice good conduct in speech.","lines":true,"ref":"Dhp 232"},{"t":[["na","na"],[" "],["tena","tena"],[" "],["paṇḍito","paṇḍito"],[" "],["hoti","hoti"],[","],["\n"],["yāvatā","yāvatā"],[" "],["bahu","bahu"],[" "],["bhāsati","bhāsati"],["."],["\n"],["khemī","khemī"],[","],[" "],["averī","averī"],[","],[" "],["abhayo","abhayo"],[","],["\n"],["“"],["paṇḍito”ti","paṇḍito”ti"],[" "],["pavuccati","pavuccati"],["."]],"en":"One is not wise because one speaks much.\nOne who is peaceful,\nkind and fearless\nis called wise.","lines":true,"ref":"Dhp 258"},{"t":[["yathā’pi","yathā’pi"],[" "],["ruciraṃ","ruciraṃ"],[" "],["pupphaṃ","pupphaṃ"],[","],["\n"],["vaṇṇavantaṃ","vaṇṇavantaṃ"],[" "],["agandhakaṃ","agandhakaṃ"],[","],["\n"],["evaṃ","evaṃ"],[" "],["subhāsitā","subhāsitā"],[" "],["vācā","vācā"],[","],["\n"],["aphalā","aphalā"],[" "],["hoti","hoti"],[" "],["akubbato","akubbato"],["."],["\n"],["yathā’pi","yathā’pi"],[" "],["ruciraṃ","ruciraṃ"],[" "],["pupphaṃ","pupphaṃ"],[","],["\n"],["vaṇṇavantaṃ","vaṇṇavantaṃ"],[" "],["sagandhakaṃ","sagandhakaṃ"],[","],["\n"],["evaṃ","evaṃ"],[" "],["subhāsitā","subhāsitā"],[" "],["vācā","vācā"],[","],["\n"],["saphalā","saphalā"],[" "],["hoti","hoti"],[" "],["kubbato","kubbato"],["."]],"en":"Just as a lovely flower, beautiful but without fragrance,\nso too, well-spoken words bring no good results\nfor one who doesn’t act accordingly.\nJust as a lovely flower, beautiful and fragrant,\nso too, well-spoken words have good results\nfor one who acts accordingly.","lines":true,"ref":"Dhp 51-52"},{"t":[["sahassam","sahassam"],[" "],["api","api"],[" "],["ce","ce"],[" "],["vācā","vācā"],[","],["\n"],["anattha-pada-saṃhitā","anattha-pada-saṃhitā"],[","],["\n"],["ekaṃ","ekaṃ"],[" "],["attha-padaṃ","attha-padaṃ"],[" "],["seyyo","seyyo"],[","],["\n"],["yaṃ","yaṃ"],[" "],["sutvā","sutvā"],[" "],["upasammati","upasammati"],["."]],"en":"Better than a thousand meaningless words\nis a single meaningful word,\nupon hearing which\none finds peace.","lines":true,"ref":"Dhp 100"}],"words":{"vacī-pakopaṃ":{"form":"vacī-pakopaṃ","lemma":"vacīpakopa","label":"masculine noun · accusative singular","ctx":"angry speech","q":"vacīpakopa","dpd":"verbal agitation; verbal irritation; verbal disturbance","construction":"vacī + pakopa","heads":[{"lemma":"vacīpakopa","meaning":"verbal agitation; verbal irritation; verbal disturbance"}],"parse":true,"pos":"masc","para":"buddha"},"rakkheyya":{"form":"rakkheyya","lemma":"rakkhati","label":"verb · optative, 3rd person singular","ctx":"one should guard against","q":"rakkhati","dpd":"wards off; prevents; guards against","construction":"rakkha + ti","heads":[{"lemma":"rakkhati","meaning":"wards off; prevents; guards against"}],"parse":true,"pos":"pr"},"vācāya":{"form":"vācāya","lemma":"vācā","label":"feminine noun · locative singular","ctx":"in speech","q":"vācā","dpd":"speech; words; statement; talk","heads":[{"lemma":"vācā","meaning":"speech; words; statement; talk"}],"parse":true,"pos":"fem","para":"saddha"},"saṃvuto":{"form":"saṃvuto","lemma":"saṃvuta","label":"past participle · masculine nominative singular","ctx":"restrained","q":"saṃvuta","dpd":"restrained; controlled; moderated (in); (comm) closed","heads":[{"lemma":"saṃvuta","meaning":"restrained; controlled; moderated (in); (comm) closed"}],"parse":true,"pos":"pp","para":"gata"},"siyā":{"form":"siyā","lemma":"atthi","label":"verb · optative, 3rd person singular (irregular)","ctx":"there would be","q":"siyā","dpd":"could be; may be; might be; should be; there could be","heads":[{"lemma":"atthi","meaning":"could be; may be; might be; should be; there could be"}],"parse":true,"pos":"pr"},"vacī-duccaritaṃ":{"form":"vacī-duccaritaṃ","lemma":"vacīduccarita","label":"neuter noun · accusative singular","ctx":"verbal misconduct","q":"vacīduccarita","dpd":"bad speech; verbal misconduct; misbehaviour in speech","construction":"vacī + duccarita","heads":[{"lemma":"vacīduccarita","meaning":"bad speech; verbal misconduct; misbehaviour in speech"}],"parse":true,"pos":"nt","para":"sila"},"hitvā":{"form":"hitvā","lemma":"hitvā","label":"absolutive","ctx":"abandoning","q":"hitvā","dpd":"having left; having left behind; having abandoned","heads":[{"lemma":"hitvā","meaning":"having left; having left behind; having abandoned"}],"parse":false,"pos":"abs"},"sucaritaṃ":{"form":"sucaritaṃ","lemma":"sucarita","label":"neuter noun · accusative singular","ctx":"good conduct","q":"sucarita","dpd":"good conduct; good behaviour (by)","lit":"well behaved","note":"vācāya sucaritaṃ: good conduct in speech.","heads":[{"lemma":"sucarita","meaning":"good conduct; good behaviour (by)"}],"parse":true,"pos":"nt","para":"sila"},"care":{"form":"care","lemma":"carati","label":"verb · optative, 3rd person singular","ctx":"one should practice","q":"carati","dpd":"acts; practices; performs; does","construction":"cara + ti","heads":[{"lemma":"carati","meaning":"acts; practices; performs; does"}],"parse":true,"pos":"pr"},"na":{"form":"na","lemma":"na","label":"indeclinable","ctx":"not","q":"na","dpd":"no; not; neither; nor","heads":[{"lemma":"na","meaning":"no; not; neither; nor"}],"parse":false,"pos":"ind"},"tena":{"form":"tena","lemma":"ta","label":"pronoun · neuter instrumental singular","ctx":"because of that","q":"ta","dpd":