i","pūrati"],["."],["\n"],["dhīro","dhīro"],[" "],["pūrati","pūrati"],[" "],["puññassa","puññassa"],[","],[" "],["thokaṃ","thokaṃ"],[" "],["thokam’pi","thokam’pi"],[" "],["ācinaṃ","ācinaṃ"],["."]],"en":"Do not underestimate the good, thinking: “This will not come\nto me”. Drop by drop, the water pot becomes full.\nSo too, the wise person fills himself with good,\ngathering it little by little.","lines":true,"ref":"Dhp 122"},{"t":[["sabba-pāpassa","sabba-pāpassa"],[" "],["akaraṇaṃ","akaraṇaṃ"],[","],["\n"],["kusalassa","kusalassa"],[" "],["upasampadā","upasampadā"],[","],["\n"],["sacitta-pariyodapanaṃ","sacitta-pariyodapanaṃ"],[" "],["—"],["\n"],["etaṃ","etaṃ"],[" "],["buddhāna","buddhāna"],[" "],["sāsanaṃ","sāsanaṃ"],["."]],"en":"The non-doing of all bad actions,\nthe performance of the wholesome,\nand the purification of one’s mind —\nthis is the teaching of the Buddhas.","lines":true,"ref":"Dhp 183"}],"words":{"yo":{"form":"yo","lemma":"ya","label":"pronoun · masculine nominative singular","ctx":"whoever (one who)","q":"ya","dpd":"whoever; whatever; whichever","heads":[{"lemma":"ya","meaning":"whoever; whatever; whichever"}],"parse":true,"pos":"pron","para":"ya"},"ca":{"form":"ca","lemma":"ca","label":"indeclinable","ctx":"and","q":"ca","dpd":"and; both","more":["but; although; and if"],"heads":[{"lemma":"ca","meaning":"and; both"}],"parse":false,"pos":"ind"},"vassa-sataṃ":{"form":"vassa-sataṃ","lemma":"vassasata","label":"neuter noun · accusative singular","ctx":"a hundred years","q":"vassasata","dpd":"one hundred years; century","construction":"vassa + sata","note":"The accusative here shows length of time: “for a hundred years”.","heads":[{"lemma":"vassasata","meaning":"one hundred years; century"}],"parse":true,"pos":"nt","para":"sila"},"jīve":{"form":"jīve","lemma":"jīvati","label":"verb · optative, 3rd person singular","ctx":"might live","q":"jīvati","dpd":"lives","heads":[{"lemma":"jīvati","meaning":"lives"}],"parse":true,"pos":"pr"},"dussīlo":{"form":"dussīlo","lemma":"dussīla","label":"adjective · masculine nominative singular","ctx":"without virtue","q":"dussīla","dpd":"unprincipled; immoral; of bad behaviour","construction":"dur + sīla","heads":[{"lemma":"dussīla","meaning":"unprincipled; immoral; of bad behaviour"}],"parse":true,"pos":"adj","para":"anicca"},"asamāhito":{"form":"asamāhito","lemma":"asamāhita","label":"past participle · masculine nominative singular","ctx":"without concentration","q":"asamāhita","dpd":"not meditatively composed; scattered; uncollected; unsettled; distracted; unsteady","lit":"not placed together here","heads":[{"lemma":"asamāhita","meaning":"not meditatively composed; scattered; uncollected; unsettled; distracted; unsteady"}],"parse":true,"pos":"pp","para":"gata"},"ek’āhaṃ":{"form":"ek’āhaṃ","lemma":"ekāha","label":"neuter noun · nominative singular","ctx":"a single day","q":"ekāha","dpd":"one day","construction":"eka + aha","note":"DPD also lists ekāhaṃ as an adverb: “for one day; for a single day”.","heads":[{"lemma":"ekāha","meaning":"one day"}],"parse":true,"pos":"nt","para":"sila"},"jīvitaṃ":{"form":"jīvitaṃ","lemma":"jīvita","label":"neuter noun · nominative singular","ctx":"life","q":"jīvita","dpd":"life; existence","more":["livelihood; lifestyle; way of life"],"heads":[{"lemma":"jīvita","meaning":"life; existence"}],"parse":true,"pos":"nt","para":"sila"},"seyyo":{"form":"seyyo","lemma":"seyya","label":"indeclinable (comparative)","ctx":"better","q":"seyyo","dpd":"better; it is better (than)","heads":[{"lemma":"seyya","meaning":"better; it is better (than)"}],"parse":false,"pos":"adj"},"sīlavantassa":{"form":"sīlavantassa","lemma":"sīlavant","label":"adjective · masculine genitive singular","ctx":"of one who has virtue","q":"sīlavant","dpd":"virtuous; ethical; moral","construction":"sīla + vant","heads":[{"lemma":"sīlavant","meaning":"virtuous; ethical; moral"}],"parse":true,"pos":"adj","para":"silava"},"jhāyino":{"form":"jhāyino","lemma":"jhāyī","label":"adjective · masculin