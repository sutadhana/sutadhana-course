"],[" "],["soṇḍo","soṇḍo"],[" "],["paṇḍako","paṇḍako"],[" "],["ca","ca"],[",\n"],["navamo","navamo"],[" "],["bhavati","bhavati"],[" "],["dārako","dārako"],[",\n"],["nav’ete","nav’ete"],[" "],["puggalā","puggalā"],[" "],["loke","loke"],[",\n"],["ittarā","ittarā"],[" "],["calitā","calitā"],[" "],["calā","calā"],[",\n"],["etehi","etehi"],[" "],["mantitaṃ","mantitaṃ"],[" "],["guyhaṃ","guyhaṃ"],[",\n"],["khippaṃ","khippaṃ"],[" "],["bhavati","bhavati"],[" "],["pākaṭan’","pākaṭan’"],["”"],["ti","ti"],["."]],"en":"“Therefore is it said:\nThe lustful, hating and deluded person,\nthe coward, and one with an eye on material gain,\na woman, a drunkard, a eunuch,\nand the child as ninth –\nthese nine persons in the world\nare unreliable, changeable, fickle.\nWhen secret things are discussed with them,\nthey quickly become well known.”"}],"words":{"bhante":{"form":"bhante","lemma":"bhante","dpdId":"49408","pos":"masc","dpd":"sir; sirs; lord; lords; venerable sir; venerable sirs; reverend; reverends","construction":"bhava + nta + e","root":"√bhū","label":"masculine noun · vocative singular","q":"bhante","decl":"<div class=\"tbl\"><table class=\"t-dpd\"><tr><td><b>Case</b></td><td><b>Singular</b></td><td><b>Plural</b></td></tr><tr><td>Nominative</td><td>bhavaṃ / bho</td><td>bhavanto / bhonto / bhavantā</td></tr><tr><td>Accusative</td><td>bhavantaṃ</td><td>bhavante</td></tr><tr><td>Instrumental</td><td>bhavatā / bhotā / bhavantena</td><td>bhavantehi / bhavantebhi</td></tr><tr><td>Dative</td><td>bhavato / bhoto / bhavantassa</td><td>bhavataṃ / bhavantānaṃ</td></tr><tr><td>Ablative</td><td>bhavatā / bhotā</td><td>bhavantehi / bhavantebhi</td></tr><tr><td>Genitive</td><td>bhavato / bhoto / bhavantassa</td><td>bhavataṃ / bhavantānaṃ</td></tr><tr><td>Locative</td><td>bhavati / bhavante / bhavantamhi / bhavantasmiṃ</td><td>bhavantesu</td></tr><tr><td>Vocative</td><td>bho / bhante</td><td>bhante / bho / bhonto / bhavanto</td></tr></table></div>","ctx":"venerable sir","heads":[{"lemma":"bha